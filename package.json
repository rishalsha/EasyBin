{
  "name": "easybin",
  "version": "1.0.0",
  "description": "An over-the-internet clipboard and CLI tool",
  "main": "server.js",
  "bin": {
    "easybin": "./cli.js"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:cli": "npx @yao-pkg/pkg cli.js --targets node18-linux-x64,node18-win-x64,node18-macos-x64,node18-macos-arm64 --out-path dist"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "sqlite3": "^5.1.7"
  }
}
